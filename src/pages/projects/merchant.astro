---
import PageLayout from '@layouts/page.astro';
import Container from '@components/container.astro';
import Head from '@components/head.astro';
import Navbar from '@components/navbar.astro';
import Footer from '@components/footer.astro';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import cover from '@assets/portfolio/merchant.png';

const study = {
  "title": "Platia Pay",
  "period": "Mar 2026 - Sep 2026",
  "description": "SvelteKit web applications for merchant payment operations and internal acquiring administration.",
  "coverAlt": "PlatiaPay merchant web application",
  "skills": [
    "Frontend development",
    "REST API integration",
    "Authentication workflows",
    "CI/CD configuration"
  ],
  "tools": [
    "SvelteKit",
    "TypeScript",
    "REST APIs",
    "Cloudflare Workers"
  ],
  "slug": "merchant"
};
---

<PageLayout>
  <head><Head title={study.title + ' Case Study'} description={study.description} permalink={'/projects/' + study.slug} /></head>
  <body>
    <Navbar />
    <Container>
      <article class="project-detail">
        <header class="project-header">
          <h1>{study.title}</h1>
          <p class="project-date">Summer 2026</p>
        </header>
        <figure class="project-cover">
          <Image src={cover} alt={study.coverAlt} widths={[480, 800, 1600]} sizes="(max-width: 864px) calc(100vw - 64px), 800px" loading="eager" fetchpriority="high" />
        </figure>
        <section class="project-section at-a-glance" aria-labelledby="at-a-glance">
          <h2 id="at-a-glance">At a Glance</h2>
          <p class="tagline">{study.description}</p>
          <dl class="details">
            <div><dt>Role</dt><dd>Software Engineer Intern</dd></div>
            <div><dt>Timeline</dt><dd>{study.period}</dd></div>
            <div class="full-width"><dt>Skills</dt><dd>{study.skills.join(' / ')}</dd></div>
            <div class="full-width">
              <dt>Tech Stack</dt>
              <dd><ul class="tech-stack" aria-label="Technologies">
                {study.tools.map((tool, index) => <li class={'tech tech-' + (index % 4)}>{tool}</li>)}
              </ul></dd>
            </div>
          </dl>
        </section>
        <section class="project-section" aria-labelledby="overview">
          <h2 id="overview">Overview</h2>
          <p>My work on Acquiring Frontend covered two connected products: a merchant web app for managing payment operations and an internal admin app for overseeing the platform. I built and refined features in SvelteKit, connected frontend workflows to REST APIs, and helped prepare both applications for deployment.</p>
          <p>Because the apps served different users, I had to understand what each person needed from the same payment system. Merchants needed clear tools for daily operations, while administrators needed broader views for account review, access control, and platform activity.</p>

          <h3 id="merchant-features">Merchant Web App Key Features</h3>
          <ul>
            <li>Merchant registration and invitations</li>
            <li>OTP and passkey authentication</li>
            <li>Dashboard metrics and recent activity</li>
            <li>Transaction and settlement review</li>
            <li>Payment link and QR payment workflows</li>
            <li>Store, register, and user management</li>
            <li>Bank account management</li>
            <li>Audit activity tracking</li>
          </ul>

          <h3 id="admin-features">Admin Web App Key Features</h3>
          <ul>
            <li>Platform dashboard and operational metrics</li>
            <li>Merchant and account review</li>
            <li>Transaction, merchant, and settlement queues</li>
            <li>Manual adjustment workflows</li>
            <li>Admin user and role management</li>
            <li>Audit activity tracking</li>
          </ul>
          <p class="privacy"><Icon name="ion:lock-closed-outline" size={18} /><span>This case study shares a high-level account of my work. </span></p>
        </section>
        <section class="project-section" aria-labelledby="takeaways">
          <h2 id="takeaways">Takeaways</h2>
          <div class="subsection">
            <h3 id="different-users">Designing for Different Users</h3>
            <p>The merchant and admin apps use the same platform, but they solve different problems. Working on both taught me to shape each workflow around the person using it instead of treating every screen the same.</p>
          </div>
          <div class="subsection">
            <h3 id="server-boundary">Working Across Client and Server</h3>
            <p>SvelteKit gave me experience beyond the browser. I worked with pages, server routes, authenticated requests, and API responses, which helped me understand where data should be loaded, transformed, and protected before reaching the interface.</p>
          </div>
          <div class="subsection">
            <h3 id="authentication">Treating Authentication as a Full Workflow</h3>
            <p>Working with registration, OTP verification, passkeys, invitations, and sessions showed me that authentication is more than a login screen. Every step needs clear feedback, safe redirects, and consistent handling when something expires or fails.</p>
          </div>
          <div class="subsection">
            <h3 id="repeatable-releases">Making Releases Repeatable</h3>
            <p>I helped bring both apps into one repository and configure GitHub Actions and Cloudflare Workers deployments. That taught me how shared checks and environment-specific settings make releases easier to repeat and troubleshoot.</p>
          </div>
        </section>
        <nav class="back-button" aria-label="More projects">
          <a href="/portfolio"><Icon name="ion:arrow-back" size={18} /> Back to Portfolio</a>
        </nav>
      </article>
    </Container>
    <Footer />
  </body>
</PageLayout>

<style lang="scss">
  @use "../../styles/platia-project";
</style>
