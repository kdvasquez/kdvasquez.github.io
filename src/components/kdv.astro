---
interface Props {
  as?: "h1" | "span";
}
const { as: Tag = "h1" } = Astro.props;
---

<Tag class:list={["kdv", { compact: Tag === "span" }]}>
  <span>K</span>
  <span>D</span>
  <span>V</span>
  <span>A</span>
  <span>S</span>
  <span>Q</span>
  <span>U</span>
  <span>E</span>
  <span>Z</span>
</Tag>

<style lang="scss">
  $t: 1s;
  $d: 0.08em;
  $n: 3;
  $e: cubic-bezier(0.86, 0, 0.07, 1);

  .kdv {
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    -khtml-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    user-select: none;
    margin: 0;
    font-size: 2rem;
    letter-spacing: 0;
    color: var(--black);
  }

  @keyframes ani {
    0% {
      transform: translate3d(0, 0, 0);
      text-shadow: 0em 0em 0 var(--light);
      color: var(--black);
    }

    30% {
      transform: translate3d(0, 0, 0);
      text-shadow: 0em 0em 0 var(--light);
      color: var(--black);
    }

    70% {
      transform: translate3d($d, -$d, 0);
      text-shadow: -$d $d var(--light);
      color: var(--black);
    }

    100% {
      transform: translate3d($d, -$d, 0);
      text-shadow: -$d $d var(--light);
      color: var(--black);
    }
  }

  .kdv > span {
    position: relative;
    display: inline-block;
    margin-right: -8px;
    animation: ani $t infinite alternate $e;

    @for $i from 1 through $n {
      &:nth-last-child(#{$i}n) {
        animation-delay: calc(-1 * $t * $i/$n/2);
      }
    }
  }

  .compact {
    display: inline-block;
    line-height: 1.3;
    font-weight: 700;
  }

  @media (prefers-reduced-motion: reduce) {
    .kdv > span {
      animation: none;
    }
  }
</style>
